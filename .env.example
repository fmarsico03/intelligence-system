# === Redis (estado de jobs + checkpoints de LangGraph + cola) ===
# Necesita Redis 8+ o Redis Stack (módulos JSON y Search para RedisSaver).
# Con docker compose se sobreescribe a redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0

# === LLM del orquestador (Gemini, con fallback entre modelos) ===
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite

# === Búsqueda web (Tavily). Sin key, el researcher usa el corpus local y no hay HITL ===
TAVILY_API_KEY=
TAVILY_CREDIT_BUDGET=1500
TAVILY_MAX_SEARCHES_PER_RUN=4

# === Observabilidad (LangSmith) ===
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=intelligence-system
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com   # solo si tu cuenta es de la región EU

# === Worker ===
RUN_EMBEDDED_WORKER=true      # false si corrés el worker como proceso aparte (python -m app.worker)
WORKER_CONCURRENCY=5
JOB_TIMEOUT_SECONDS=600

# === Human-in-the-loop ===
# Créditos que se aprueban solos. 0 = toda búsqueda paga requiere aprobación humana.
HITL_AUTO_APPROVE_MAX_CREDITS=0

# === RAG: Pinecone (base vectorial del agente "knowledge") ===
PINECONE_API_KEY=
INDEX_NAME=hybrid-rag
PINECONE_NAMESPACE=docs
CLOUD=aws
REGION=us-east-1

# === RAG: embeddings (Pinecone Inference) ===
EMBED_MODEL=multilingual-e5-large

# === RAG: LLM de generación grounded ===
LLM_MODEL=gemini-3.8-flash
